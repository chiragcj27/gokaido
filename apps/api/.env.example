PORT=3001
MONGODB_URI=mongodb://localhost:27017/gokaido

# Comma-separated list of origins allowed to call this API from a browser
# (the storefront and admin portal). Defaults to the local dev ports below.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Public storefront base URL — used to build absolute product links and image
# URLs in the Google Shopping feed (/api/feeds/google-shopping.xml).
SITE_URL=http://localhost:3000

# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=

# MSG91 — SMS (OTP + order updates), WhatsApp and email. Leave MSG91_AUTH_KEY
# blank in dev to log OTPs/messages to the console instead of sending.
MSG91_AUTH_KEY=
# DLT-approved OTP template (must contain ##OTP##)
MSG91_OTP_TEMPLATE_ID=
# WhatsApp Business number integrated in MSG91, with country code, no "+"
MSG91_WHATSAPP_NUMBER=
# Email sender — domain must be verified in MSG91 (DKIM is signed with it)
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=Gokaido
# Order-update templates: MSG91_{WHATSAPP|SMS|EMAIL}_{EVENT}, where EVENT is
# ORDER_CONFIRMED / ORDER_SHIPPED / ORDER_DELIVERED / ORDER_CANCELLED /
# ORDER_REFUNDED. WhatsApp = template name, SMS = Flow template ID, email =
# template ID. Unset = that channel is skipped for that event. Variable order
# per event is in src/services/notifications.ts (EVENT_VARIABLES).
MSG91_WHATSAPP_ORDER_CONFIRMED=
MSG91_SMS_ORDER_CONFIRMED=
MSG91_EMAIL_ORDER_CONFIRMED=
MSG91_WHATSAPP_ORDER_SHIPPED=
MSG91_SMS_ORDER_SHIPPED=
MSG91_EMAIL_ORDER_SHIPPED=
MSG91_WHATSAPP_ORDER_DELIVERED=
MSG91_SMS_ORDER_DELIVERED=
MSG91_EMAIL_ORDER_DELIVERED=
MSG91_WHATSAPP_ORDER_CANCELLED=
MSG91_SMS_ORDER_CANCELLED=
MSG91_EMAIL_ORDER_CANCELLED=
MSG91_WHATSAPP_ORDER_REFUNDED=
MSG91_SMS_ORDER_REFUNDED=
MSG91_EMAIL_ORDER_REFUNDED=

# ICICI Bank Payment Gateway — get merchant/aggregator ID and secret key from
# ICICI onboarding. UAT base URL shown; production is https://pgpay.icicibank.com/pg/api
ICICI_PG_BASE_URL=https://pgpayuat.icicibank.com/tsp/pg/api
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_SECRET_KEY=

# Publicly reachable base URL of this API — ICICI redirects the customer's
# browser back here after payment (must be a real public URL, not localhost,
# outside of a tunnel like ngrok for local testing).
API_PUBLIC_URL=http://localhost:3001

# AWS S3 — product images, review media, blog assets. Bucket only serves
# public reads under the "public/" key prefix (see bucket policy); everything
# else is private. Get access keys from an IAM user scoped to this bucket,
# never the root account.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=gokaido-web-storage
