PORT=3001
MONGODB_URI=mongodb://localhost:27017/gokaido

# Comma-separated list of origins allowed to call this API from a browser
# (the storefront and admin portal). Defaults to the local dev ports below.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Public storefront base URL — used to build absolute product links and image
# URLs in the Google Shopping feed (/api/feeds/google-shopping.xml).
SITE_URL=http://localhost:3000

# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=

# Twilio (leave blank to use console.log fallback in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+91XXXXXXXXXX
